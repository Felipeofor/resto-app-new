# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Configuration (if using WhatsApp API instead of links)
WHATSAPP_API_KEY=optional-api-key
WHATSAPP_PHONE_NUMBER=your-business-number

# Payment Gateway (for future integration)
STRIPE_SECRET_KEY=optional-stripe-key
STRIPE_PUBLISHABLE_KEY=optional-stripe-publishable-key

# MercadoPago (for Argentine users)
MERCADOPAGO_ACCESS_TOKEN=optional-mp-token

# Email Configuration (for order confirmations)
SMTP_HOST=optional-smtp-host
SMTP_PORT=587
SMTP_USER=optional-email@example.com
SMTP_PASSWORD=optional-password
SMTP_FROM_EMAIL=orders@restaurant.com

# Analytics (optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
POSTHOG_API_KEY=optional-posthog-key

# Feature Flags
ENABLE_DELIVERY_FEE=true
ENABLE_SCHEDULED_ORDERS=false
ENABLE_LOYALTY_PROGRAM=false
ENABLE_RATINGS=true

# App Configuration
NEXT_PUBLIC_APP_NAME=Mi Restaurante
NEXT_PUBLIC_CURRENCY_SYMBOL=$
NEXT_PUBLIC_CURRENCY_CODE=ARS

# Admin Dashboard
ADMIN_PASSWORD_HASH=optional-hash
ADMIN_2FA_SECRET=optional-secret

# Webhook Secrets
STRIPE_WEBHOOK_SECRET=optional-webhook-secret
MERCADOPAGO_WEBHOOK_SECRET=optional-webhook-secret

# Development
DEBUG=false
LOG_LEVEL=info
